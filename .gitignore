# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Ignore contents of data & results directories
data/raw/*
data/calibrated/*
data/reference/nac/*
data/reference/wac/*
data/pairs/*
data/processed/*
data/metadata/gt/*
results/*

# Explicitly track directory placeholders and metadata templates
!.gitkeep
!data/metadata/roi_manifest.csv

# Large Datasets, Images & Binary Extensions (Safety fallback)
*.IMG
*.img
*.TIF
*.tif
*.cub
*.zip
*.qub
*.jsonl

# Internal drafts & ignored compendiums
ARCHITECTURE/
ALL_IN_ONE_*.md
BEST_ARCHITECTURE_KNOWN.md

# OS / Editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
